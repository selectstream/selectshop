---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout 
  title="Audit Intake | SelectStream Sovereign Lab"
  description="Submit your workstation parameters and photos to initialize the Sovereign Audit protocol."
>
  <div class="intake-stage">
    <div class="intake-header">
      <span class="secure-tag">🔒 TRANSACTION_SUCCESSFUL // SECURE_CHANNEL</span>
      <h1>AUDIT_PARAMETER_INTAKE</h1>
      <p class="subtitle">The Sovereign Setup Audit protocol has been initialized. Provide your empirical workstation metrics below to begin diagnosis.</p>
    </div>

    <form class="intake-form" id="audit-intake-form">
      <div class="form-section">
        <span class="section-label">01_IDENTIFICATION</span>
        
        <div class="input-group">
          <label for="intake-email">LICENSING_EMAIL (Matches purchase email)</label>
          <input type="email" id="intake-email" placeholder="engineer@lab.sovereign" required />
        </div>
      </div>

      <div class="form-section">
        <span class="section-label">02_BIOMETRIC_PROFILE</span>
        
        <div class="grid-inputs">
          <div class="input-group">
            <label for="intake-height">OPERATOR_HEIGHT (cm)</label>
            <input type="number" id="intake-height" placeholder="180" required />
          </div>
          <div class="input-group">
            <label for="intake-desk-type">DESK_TYPE</label>
            <select id="intake-desk-type" required>
              <option value="fixed">FIXED HEIGHT</option>
              <option value="sit-stand">SIT-STAND (ELECTRIC)</option>
              <option value="custom">CUSTOM / MANUAL</option>
            </select>
          </div>
        </div>
      </div>

      <div class="form-section">
        <span class="section-label">03_COGNITIVE_BOTTLENECKS</span>
        
        <div class="input-group">
          <label for="intake-pain">PRIMARY_WORKSTATION_FATIGUE_FACTOR</label>
          <select id="intake-pain" required>
            <option value="lumbar">LUMBAR / POSTURE PAIN</option>
            <option value="latency">INPUT LATENCY / SOFTWARE SLOWDOWN</option>
            <option value="focus">COGNITIVE DISTRACTION / CLUTTER</option>
            <option value="lighting">EYESTRAIN / INSUFFICIENT LIGHTING</option>
          </select>
        </div>

        <div class="input-group">
          <label for="intake-details">EXPANDED_DIAGNOSTICS_AND_NOTES</label>
          <textarea id="intake-details" rows="4" placeholder="Detail any hardware quirks, software latency, or room lighting conditions..."></textarea>
        </div>
      </div>

      <div class="form-section">
        <span class="section-label">04_VISUAL_ASSETS</span>
        <div class="asset-instructions">
          <p>To perform the layout and acoustic mapping, we require <strong>three high-resolution workspace photos</strong>:</p>
          <ul class="photo-checklist">
            <li>[+] <strong>Wide View</strong> (The entire room showing desk placement)</li>
            <li>[+] <strong>Desk View</strong> (Direct front angle showing monitor, keyboard, chair)</li>
            <li>[+] <strong>Side Profile</strong> (Showing seating/monitor height angles)</li>
          </ul>
          <div class="asset-actions">
            <p class="drop-notice">Email photos to <a href="mailto:audit@selectstreamshop.com">audit@selectstreamshop.com</a> referencing your email, or upload to our secure vault:</p>
            <a href="https://dropbox.com/request/selectstream-audit" target="_blank" class="vault-link-btn">OPEN_SECURE_DROPBOX_VAULT</a>
          </div>
        </div>
      </div>

      <button type="submit" class="submit-btn" id="submit-intake">INITIALIZE_SYSTEM_DIAGNOSIS</button>
    </form>

    <div class="success-screen" id="success-screen" style="display: none;">
      <span class="lock-icon">⚡</span>
      <h2>DIAGNOSIS_PROTOCOL_QUEUED</h2>
      <p>Your setup parameters have been anchored. Our engineering team will review your biometrics, cognitive bottlenecks, and assets within 48 hours.</p>
      <p class="monospaced-sub">A formal markdown report with your custom blueprints and curations will be delivered to your inbox.</p>
      <a href="/" class="return-home-btn">RETURN_TO_ARCHIVE</a>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('audit-intake-form') as HTMLFormElement;
  const successScreen = document.getElementById('success-screen');
  const submitBtn = document.getElementById('submit-intake');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'ANCHORING_PARAMETERS...';
    }

    const email = (document.getElementById('intake-email') as HTMLInputElement).value;
    const height = (document.getElementById('intake-height') as HTMLInputElement).value;
    const deskType = (document.getElementById('intake-desk-type') as HTMLSelectElement).value;
    const primaryPain = (document.getElementById('intake-pain') as HTMLSelectElement).value;
    const notes = (document.getElementById('intake-details') as HTMLTextAreaElement).value;

    try {
      const response = await fetch('/api/setup/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          setupName: 'Audit Intake Config',
          items: { height, deskType, primaryPain, notes }
        })
      });

      if (response.ok) {
        form.style.display = 'none';
        if (successScreen) successScreen.style.display = 'flex';
      } else {
        throw new Error('Database sync failed');
      }
    } catch (err) {
      alert('SYNC_ERROR: Parameter anchoring failed. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'INITIALIZE_SYSTEM_DIAGNOSIS';
      }
    }
  });
</script>

<style>
  .intake-stage {
    max-width: 700px;
    margin: 6rem auto 10rem auto;
    padding: 0 2rem;
  }

  .intake-header {
    margin-bottom: 5rem;
    text-align: center;
  }

  .secure-tag {
    font-family: var(--family-mono);
    font-size: 0.5rem;
    color: #00ff88;
    letter-spacing: 0.15rem;
    display: block;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: -0.15rem;
    line-height: 1;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .subtitle {
    font-size: 1rem;
    color: #666;
    line-height: 1.5;
  }

  .intake-form {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .form-section {
    border-top: 1px solid #111;
    padding-top: 2.5rem;
  }

  .section-label {
    font-family: var(--family-mono);
    font-size: 0.55rem;
    color: #444;
    letter-spacing: 0.2rem;
    display: block;
    margin-bottom: 2.5rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .grid-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  label {
    font-family: var(--family-mono);
    font-size: 0.5rem;
    color: #333;
    letter-spacing: 0.1rem;
    font-weight: 900;
  }

  input, select, textarea {
    background: #050505;
    border: 1px solid #111;
    padding: 1.2rem;
    color: #fff;
    font-family: var(--family-mono);
    font-size: 0.8rem;
    outline: none;
    border-radius: 2px;
    width: 100%;
  }

  input:focus, select:focus, textarea:focus {
    border-color: #333;
    background: #080808;
  }

  /* VISUAL ASSET SECURE ACTIONS */
  .asset-instructions p {
    font-size: 0.9rem;
    color: #888;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .photo-checklist {
    list-style: none;
    margin-bottom: 2.5rem;
  }

  .photo-checklist li {
    font-family: var(--family-mono);
    font-size: 0.6rem;
    color: #444;
    margin-bottom: 0.8rem;
    letter-spacing: 0.05rem;
  }

  .asset-actions {
    background: #050505;
    border: 1px solid #111;
    padding: 2rem;
    border-radius: 4px;
  }

  .asset-actions p {
    font-size: 0.8rem;
    color: #555;
    margin-bottom: 1.5rem;
  }

  .asset-actions a {
    color: #00ff88;
    text-decoration: underline;
  }

  .vault-link-btn {
    display: block;
    background: #111;
    color: #fff !important;
    text-decoration: none !important;
    border: 1px solid #222;
    text-align: center;
    padding: 1.2rem;
    font-family: var(--family-mono);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.15rem;
    transition: all 0.3s ease;
    border-radius: 2px;
  }

  .vault-link-btn:hover {
    background: #fff;
    color: #000 !important;
    border-color: #fff;
  }

  .submit-btn {
    background: #fff;
    color: #000;
    border: none;
    padding: 1.5rem;
    font-family: var(--family-mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.15rem;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 2px;
    margin-top: 2rem;
  }

  .submit-btn:hover:not(:disabled) {
    background: #00ff88;
    transform: translateY(-3px);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* SUCCESS SCREEN */
  .success-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    background: #050505;
    border: 1px solid #111;
    border-radius: 4px;
    animation: reveal 0.8s forwards;
  }

  @keyframes reveal { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .success-screen .lock-icon {
    font-size: 2.5rem;
    color: #00ff88;
    margin-bottom: 2rem;
    text-shadow: 0 0 20px rgba(0,255,136,0.3);
  }

  .success-screen h2 {
    font-size: 1.8rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.1rem;
    margin-bottom: 1.5rem;
  }

  .success-screen p {
    font-size: 0.95rem;
    color: #888;
    line-height: 1.6;
    max-width: 500px;
    margin-bottom: 1.5rem;
  }

  .monospaced-sub {
    font-family: var(--family-mono);
    font-size: 0.55rem !important;
    color: #444 !important;
    letter-spacing: 0.05rem;
    margin-bottom: 3rem !important;
  }

  .return-home-btn {
    background: #fff;
    color: #000;
    padding: 1.2rem 2.5rem;
    font-family: var(--family-mono);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 2px;
  }

  .return-home-btn:hover {
    background: #00ff88;
    transform: translateY(-2px);
  }
</style>
